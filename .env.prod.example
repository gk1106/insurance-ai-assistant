# Copy to the repository-root .env and fill the blank secrets.
# Generate DB/admin secrets: openssl rand -hex 32
# Generate JWT secret: openssl rand -base64 64
# The generated local .env already contains unique DB/JWT/admin secrets.
# This public example intentionally contains no credentials.

COMPOSE_PROJECT_NAME=insurance
# Frontend metadata is baked by PUBLIC_SITE_URL in the GitHub workflow.
SITE_URL=https://insurance.gkbuilds.in
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8085
CORS_ALLOWED_ORIGINS=https://insurance.gkbuilds.in
POSTGRES_DB=insurance_ai
POSTGRES_USER=insurance_ai_prod
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
APP_BOOTSTRAP_ADMIN_USERNAME=insurance_admin
APP_BOOTSTRAP_ADMIN_EMAIL=admin@gkbuilds.in
APP_BOOTSTRAP_ADMIN_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
TZ=Asia/Kolkata

# The update script overrides this with the exact successful Git commit tag.
IMAGE_TAG=latest
