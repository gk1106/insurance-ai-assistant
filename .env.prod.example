# Copy this file to .env (same directory as docker-compose.prod.yml) and fill in real values.
# docker compose loads .env automatically; it is git-ignored, this example file is not.
# Every variable below is required -- docker-compose.prod.yml will refuse to start with a clear
# error message if one is missing, rather than silently falling back to a dev/test value.

# --- Database ---------------------------------------------------------
POSTGRES_DB=insurance_ai
POSTGRES_USER=insurance_ai_prod
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Auth ---------------------------------------------------------------
# Generate with: openssl rand -base64 48
# Must be different from the value committed in application.yml's dev fallback -- that one is
# public (it's in the repo), so it must never be used outside local development.
JWT_SECRET=
# Optional -- defaults to 3600000 (1 hour) in the prod profile if left unset.
JWT_EXPIRATION_MS=3600000

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=
# Optional -- defaults to gpt-5-mini if left unset.
OPENAI_MODEL=gpt-5-mini

# --- Frontend / CORS ---------------------------------------------------------------
# The real origin(s) the frontend is served from, comma-separated, no trailing slash.
CORS_ALLOWED_ORIGINS=https://your-domain.com
# Host port the frontend (nginx) container listens on. Put a TLS-terminating reverse proxy /
# load balancer in front of this in an actual deployment; this compose file does not set one up.
FRONTEND_PORT=80

# --- Misc ---------------------------------------------------------------
TZ=UTC
